{
  "name": "touchbar-addon-new-ff",
  "version": "0.2.1",
  "description": "Native macOS Touch Bar controls for Firefox",
  "author": "viktorstrate <viktorstrate@gmail.com>, VisionCrizzal",
  "license": "GPL-3.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "lint": "node scripts/build.mjs && web-ext lint -s ./dist",
    "package": "node scripts/build.mjs && web-ext build -s ./dist --overwrite-dest",
    "package:source": "node scripts/package-source.mjs",
    "sign:unlisted": "node scripts/sign-unlisted.mjs",
    "sign:listed": "node scripts/sign-listed.mjs",
    "launch": "node scripts/build.mjs && web-ext run -s ./dist"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "web-ext": "^10.8.0"
  }
}
