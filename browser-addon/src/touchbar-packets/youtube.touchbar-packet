// ==TouchbarPacket==
// @name YouTube
// @match https://www.youtube.com/*
// ==/TouchbarPacket==

/* global touchbar:readonly */

(() => {
  if (window.__touchbarYoutubeLoaded) return
  window.__touchbarYoutubeLoaded = true

  console.log('TOUCHBAR SCRIPT EXECUTING on', window.location.href)

let onEventFunction = null
let retryTimerId = null
let cleanupListeners = []

touchbar.addEventListener(message => {
  if (onEventFunction) onEventFunction(message)
})

function cleanupCurrentPage() {
  if (retryTimerId !== null) {
    clearTimeout(retryTimerId)
    retryTimerId = null
  }

  while (cleanupListeners.length > 0) {
    const fn = cleanupListeners.pop()
    try {
      fn()
    } catch (err) {
      console.warn('Error cleaning up touchbar listener:', err)
    }
  }

  onEventFunction = null
}

configureTouchbar()
function configureTouchbar() {
  cleanupCurrentPage()
  console.log('Configuring touchbar for', window.location.pathname)

  if (
    window.location.pathname === '/watch' ||
    window.location.pathname.startsWith('/shorts/')
  ) {
    setupVideoPage(0)
  } else {
    setupGeneralNavigation()
  }
}

function setupGeneralNavigation() {
  const ACTION_HOME = 'navigate-home'
  const ACTION_TRENDING = 'navigate-trending'
  const ACTION_SUBSCRIPTIONS = 'navigate-subscriptions'
  const ACTION_SHORTS = 'navigate-shorts'

  touchbar.changeLayout([
    {
      type: 'button',
      name: ACTION_HOME,
      label: 'Home',
      symbol: 'house',
    },
    {
      type: 'button',
      name: ACTION_TRENDING,
      label: 'Trending',
      symbol: 'flame',
    },
    {
      type: 'button',
      name: ACTION_SHORTS,
      label: 'Shorts',
      symbol: 'play.rectangle',
    },
    {
      type: 'button',
      name: ACTION_SUBSCRIPTIONS,
      label: 'Subscriptions',
      symbol: 'rectangle.stack',
    },
  ])

  onEventFunction = message => {
    if (message.type == 'action') {
      const menuItems = document.querySelectorAll(
        '#items > ytd-guide-entry-renderer'
      )
      switch (message.name) {
        case ACTION_HOME:
          if (menuItems[0]) {
            menuItems[0].click()
          } else {
            location.href = '/'
          }
          break
        case ACTION_TRENDING:
          if (menuItems[1]) {
            menuItems[1].click()
          } else {
            location.href = '/feed/trending'
          }
          break
        case ACTION_SHORTS:
          if (menuItems[2]) {
            menuItems[2].click()
          } else {
            location.href = '/shorts'
          }
          break
        case ACTION_SUBSCRIPTIONS:
          if (menuItems[3]) {
            menuItems[3].click()
          } else {
            location.href = '/feed/subscriptions'
          }
          break
      }
    }
  }
}

function formatTimestamp(time) {
  if (!Number.isFinite(time) || time < 0) {
    return '0:00'
  }

  const totalSeconds = Math.floor(time)
  const hours = Math.floor(totalSeconds / 3600)
  const minutes = Math.floor((totalSeconds % 3600) / 60)
  const seconds = totalSeconds % 60
  const secStr = seconds < 10 ? `0${seconds}` : `${seconds}`

  if (hours > 0) {
    const minStr = minutes < 10 ? `0${minutes}` : `${minutes}`
    return `${hours}:${minStr}:${secStr}`
  }

  return `${minutes}:${secStr}`
}

function getProgressRatio(video) {
  if (
    !Number.isFinite(video.duration) ||
    video.duration <= 0 ||
    !Number.isFinite(video.currentTime)
  ) {
    return 0
  }

  return Math.min(1, Math.max(0, video.currentTime / video.duration))
}

function isVisibleVideo(el) {
  return Boolean(el && el.offsetWidth > 0 && el.offsetHeight > 0)
}

function findActiveVideo() {
  const prioritySelectors = [
    '#movie_player video.html5-main-video',
    'ytd-watch-flexy #movie_player video',
    'ytd-watch-grid #movie_player video',
    '#shorts-player video.html5-main-video',
    'ytd-reel-video-renderer[is-active] video',
  ]

  for (const selector of prioritySelectors) {
    const candidate = document.querySelector(selector)
    if (isVisibleVideo(candidate)) {
      return candidate
    }
  }

  const allVideos = Array.from(
    document.querySelectorAll('video.video-stream, video')
  ).filter(el => !el.closest('#inline-preview-player') && isVisibleVideo(el))

  return (
    allVideos.find(el => el.readyState > 0 || Boolean(el.currentSrc)) ||
    allVideos[0] ||
    null
  )
}

function setupVideoPage(attempt = 0) {
  const PLAYBACK_SLIDER = 'playback-slider'
  const MEDIA_PLAYPAUSE_BUTTON = 'media-playpause'
  const MEDIA_BACK_10 = 'media-back-10'
  const MEDIA_FWD_10 = 'media-fwd-10'
  const SYMBOL_PLAY = 'play.fill'
  const SYMBOL_PAUSE = 'pause.fill'

  const video = findActiveVideo()
  if (!video) {
    if (attempt < 20) {
      retryTimerId = setTimeout(() => {
        retryTimerId = null
        setupVideoPage(attempt + 1)
      }, 500)
    }
    return
  }

  let lastSyncAt = 0

  const sendInitialLayout = () => {
    const playPauseButton = {
      type: 'button',
      name: MEDIA_PLAYPAUSE_BUTTON,
      label: '',
      symbol: video.paused ? SYMBOL_PLAY : SYMBOL_PAUSE,
      width: 36,
    }

    const skipBackButton = {
      type: 'button',
      name: MEDIA_BACK_10,
      label: '',
      symbol: 'gobackward.10',
      width: 36,
    }

    const skipForwardButton = {
      type: 'button',
      name: MEDIA_FWD_10,
      label: '',
      symbol: 'goforward.10',
      width: 36,
    }

    const playbackSlider = {
      type: 'slider',
      name: PLAYBACK_SLIDER,
      label: formatTimestamp(video.currentTime),
      value: getProgressRatio(video),
      color: '#ff0000',
    }

    lastSyncAt = Date.now()
    touchbar.changeLayout([
      playPauseButton,
      skipBackButton,
      skipForwardButton,
      playbackSlider,
    ])
  }

  const syncPlayPause = () => {
    touchbar.updateItem(MEDIA_PLAYPAUSE_BUTTON, {
      symbol: video.paused ? SYMBOL_PLAY : SYMBOL_PAUSE,
    })
  }

  const syncSlider = (force = false) => {
    const now = Date.now()
    if (!force && now - lastSyncAt < 400) {
      return
    }
    lastSyncAt = now
    touchbar.updateItem(PLAYBACK_SLIDER, {
      value: getProgressRatio(video),
      label: formatTimestamp(video.currentTime),
    })
  }

  sendInitialLayout()

  const onPlay = () => {
    syncPlayPause()
    syncSlider(true)
  }

  const onPauseOrEnd = () => {
    syncPlayPause()
    syncSlider(true)
  }

  const onTimeUpdate = () => {
    syncSlider(false)
  }

  const onImmediateSync = () => {
    syncSlider(true)
  }

  video.addEventListener('play', onPlay)
  video.addEventListener('pause', onPauseOrEnd)
  video.addEventListener('ended', onPauseOrEnd)
  video.addEventListener('timeupdate', onTimeUpdate)
  video.addEventListener('loadedmetadata', onImmediateSync)
  video.addEventListener('durationchange', onImmediateSync)
  video.addEventListener('seeked', onImmediateSync)

  cleanupListeners.push(() => {
    video.removeEventListener('play', onPlay)
    video.removeEventListener('pause', onPauseOrEnd)
    video.removeEventListener('ended', onPauseOrEnd)
    video.removeEventListener('timeupdate', onTimeUpdate)
    video.removeEventListener('loadedmetadata', onImmediateSync)
    video.removeEventListener('durationchange', onImmediateSync)
    video.removeEventListener('seeked', onImmediateSync)
  })

  onEventFunction = message => {
    if (message.type == 'action' && message.target == 'button') {
      switch (message.name) {
        case MEDIA_PLAYPAUSE_BUTTON:
          if (video.paused) {
            const playPromise = video.play()
            if (playPromise && typeof playPromise.catch === 'function') {
              playPromise.catch(() => {
                document.querySelector('#movie_player .ytp-play-button')?.click()
              })
            }
          } else {
            video.pause()
          }
          break
        case MEDIA_BACK_10:
          video.currentTime = Math.max(0, (video.currentTime || 0) - 10)
          syncSlider(true)
          break
        case MEDIA_FWD_10: {
          const next = (video.currentTime || 0) + 10
          video.currentTime = Number.isFinite(video.duration)
            ? Math.min(video.duration, next)
            : next
          syncSlider(true)
          break
        }
      }
    }

    if (message.type == 'action' && message.target == 'slider') {
      if (message.name === PLAYBACK_SLIDER) {
        if (
          Number.isFinite(video.duration) &&
          video.duration > 0 &&
          Number.isFinite(message.value)
        ) {
          const ratio = Math.min(1, Math.max(0, message.value))
          const targetTime = video.duration * ratio
          video.currentTime = targetTime
          lastSyncAt = Date.now()
          touchbar.updateItem(PLAYBACK_SLIDER, {
            value: ratio,
            label: formatTimestamp(targetTime),
          })
        }
      }
    }
  }
}

hookPageChanges()
function hookPageChanges() {
  let lastHref = location.href

  const handlePossibleNavigation = () => {
    if (location.href !== lastHref) {
      lastHref = location.href
      console.log('YouTube navigation detected:', lastHref)
      configureTouchbar()
    }
  }

  window.addEventListener('yt-navigate-finish', handlePossibleNavigation)
  window.addEventListener('popstate', handlePossibleNavigation)
  setInterval(handlePossibleNavigation, 500)
}
})()
